(version 2.5.2)

(build
 (all_platforms
  ((action
    (progn
     (run ./configure --disable-checks --prefix %{prefix})
     (run dune build -p %{pkg-self:name} -j %{jobs}))))))

(depends
 (all_platforms
  (ocaml opam-repository re spdx_licenses patch dune)))

(source
 (fetch
  (url https://github.com/ocaml/opam/archive/refs/tags/2.5.2.tar.gz)
  (checksum
   sha512=0b15627c4a31d3abcdbb5885bf2e7f4dee9ffddad2144855d1e1e18d66edc379e3a2b0a378097c35897e571f856b61aadabb47672d75401f6f6231f33ae475c8)))
