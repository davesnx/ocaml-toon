(version 0.3.4)

(build
 (progn
  (when
   %{pkg-self:dev}
   (run dune subst))
  (run dune build -p %{pkg-self:name} -j %{jobs} @install)))

(depends dune ocaml fpath re ppx_deriving testo-diff)

(source
 (fetch
  (url
   https://github.com/semgrep/testo/releases/download/0.3.4/testo-0.3.4.tbz)
  (checksum
   sha256=50c4ad248a3234274c84f80b56d2c4007238c65cfd1e0a66b1952deaf04a4765)))
